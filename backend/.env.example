# ================= resume-advisor 配置模板 =================
# 复制为 .env 后按需填写；不填则全部使用默认值/模拟数据

# --- 服务 ---
HOST=127.0.0.1
PORT=8000

# --- LLM (OpenAI 兼容格式) ---
# 默认 DeepSeek；也可填 Ollama 本地地址 http://127.0.0.1:11434/v1
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3

# --- 公司本地库 (可选，复用 Company-lookup 数据库) ---
# 留空则使用内置模拟数据
COMPANY_DB_PATH=E:\自己制作的项目\Company-lookup\company_data.db

# --- 数据源 API (预留企查查/天眼查，无 Key 时使用模拟数据) ---
QCC_API_KEY=
TIANYANCHA_API_KEY=

# --- 隐私 ---
# 临时文件自动删除开关
AUTO_CLEAN_TEMP=true
