# ================= resume-advisor 配置模板 =================
# 复制为 .env 后按需填写；不填则全部使用默认值/模拟数据
#
# ⚠️ 重要：LLM 与搜索 API 配置主要由【前端设置页】传入（存于浏览器 localStorage，
# 请求 /api/analyze 时随表单提交，不落盘到后端）。下方环境变量仅为后端默认值兜底。

# --- 服务 ---
HOST=127.0.0.1
PORT=8000

# --- LLM (OpenAI 兼容格式, 默认兜底值) ---
# 前端未传配置时的默认；实际以前端设置页为准
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o

# --- 搜索 (可选: serper / tavily) ---
# 前端设置页选择服务并填 Key 后随请求传入；未配置则仅用 LLM 内部知识（标注“非实时”）
SEARCH_PROVIDER=
SEARCH_API_KEY=

# --- 公司本地库 (可选，复用 Company-lookup 数据库) ---
# 留空则使用内置模拟数据
COMPANY_DB_PATH=E:\自己制作的项目\Company-lookup\company_data.db

# --- 隐私 ---
# 临时文件自动删除开关
AUTO_CLEAN_TEMP=true
